{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReportPhotosOnly",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:PutObjectTagging"
      ],
      "Resource": "arn:aws:s3:::REPLACE_WITH_BUCKET/attachments/*"
    }
  ]
}
